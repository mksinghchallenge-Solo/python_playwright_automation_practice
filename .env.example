# ===========================================================================
# Coca-Cola Automation Framework - environment variables
# Copy to .env and fill in values. NEVER commit .env (it is git-ignored).
# ===========================================================================

# ---- Which environment to run against: local | qa | staging | prod
ENV=local

# ---- Optional overrides of config/config.yaml
# BROWSER=chromium            # chromium | chrome | msedge | firefox | webkit
# HEADLESS=true
# SLOW_MO=0
# MOBILE_ENABLED=false
# MOBILE_DEVICE=Pixel 7
# SCREENSHOT_MODE=retain-on-failure   # always | retain-on-failure | never
# VIDEO_MODE=retain-on-failure
# TRACE_MODE=retain-on-failure
# LOG_LEVEL=INFO
# MASK_SECRETS=true

# ---- Optional URL overrides (take precedence over environments/<env>.yaml)
# UI_BASE_URL=https://www.coca-cola.com/us/en
# API_BASE_URL=<REAL_API_BASE_URL>

# ---- API credentials (test accounts only - never personal/production users)
API_USER_EMAIL=demo.user@example.com
API_USER_PASSWORD=Demo@12345
# API_STATIC_TOKEN=            # optional long-lived test token instead of login
# API_KEY=                     # if the API uses an API key header

# ---- UI test credentials (used by tests/ui/auth when the real login exists)
UI_USER_EMAIL=demo.user@example.com
UI_USER_PASSWORD=Demo@12345

# ---- Production write protection (double lock with prod.yaml safety flags)
ALLOW_PROD_WRITES=false

# ---- Generated data
TEST_DATA_PREFIX=autotest
TEST_EMAIL_DOMAIN=example.com

# ---- Report retention (scripts/cleanup_reports.py)
RETENTION_ENABLED=false
RETENTION_DAYS=30
RETENTION_EXECUTIONS=50

# ---- Optional: custom Chromium binary (restricted CI images only)
# PLAYWRIGHT_CHROMIUM_EXECUTABLE=/path/to/chromium
