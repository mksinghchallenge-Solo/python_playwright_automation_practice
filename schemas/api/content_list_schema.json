{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ContentList",
  "type": "object",
  "required": ["items"],
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title"],
        "properties": {
          "id": {"type": "string"},
          "title": {"type": "string"},
          "type": {"type": "string"}
        }
      }
    },
    "total": {"type": "integer", "minimum": 0}
  }
}
